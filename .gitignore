# Autopilot scratch — the Clubhouse autopilot's model step writes its reply and
# image requests here at runtime. Ignored so it never gets swept into the
# action's auto-created branch or committed to main.
.autopilot/

# Playwright is installed on demand to run games/*/browser.test.js — the repo
# itself has no build system and ships nothing from here.
node_modules/

# stray bytecode from running the art pipeline locally
__pycache__/
*.pyc

# Room sign-off RENDER MARKERS are local evidence, not shared state.
# room.py check writes one to record that the overlays were rendered for the
# art as it stands HERE; room.py signoff refuses unless it matches. Committing
# them would let someone sign off a room on another machine without ever
# rendering it, which is the whole thing that check is there to stop.
games/*/art-src/*_rendered.txt

# CI checks panel-game out here (actions/checkout cannot write above the
# workspace). Never part of this repo.
/panel-game/

# Smoke-sized training runs are not results — see commit_snapshot.sh
games/the-game/ai/eval/*.smoke.json

# The chains-fired measure's scratch: weights in, result JSON out, both
# removed in a finally block. Ignored so a run killed mid-measure cannot
# leave one to be committed. Its test's temp dir is ignored for the same
# reason.
games/the-game/ai/eval/.chainmeasure.*
games/the-game/ai/eval/.chainmeasure-test-*/

# The Puyo loop's population, same rule as train.js's checkpoint: it is a
# resume point, committed deliberately by commit_snapshot.sh, never swept in.
.versus-checkpoint.*.json
.pbt-*/

# training.test.js points train.js's checkpoint here with GC_CHECKPOINT_DIR,
# so a gate run cannot rewrite the tracked checkpoint beside train.js.
games/the-game/ai/eval/.training-test-scratch/

# snapshot_pipe.test.js builds a throwaway git repo here and removes it;
# this covers a crash that leaves one behind.
games/the-game/ai/eval/.snapshot-pipe-scratch/

# train_pbt.js drops this when it stops because another leg will not fit;
# the workflow reads it to tell a clean handover from a crash loop.
games/the-game/ai/eval/.pbt-clean-stop

# Scratch from the duel fan-out (duels.js). Cleaned up on exit; a killed
# run leaks them, and a leaked one must never be committable.
.duels.*.json

# The tournament's standings: a measurement, rewritten by every run. The
# corpus beside it IS committed, because a fixed benchmark is the point of it.
games/the-game/ai/eval/tournament.json
