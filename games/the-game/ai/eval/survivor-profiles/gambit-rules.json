{
 "rules": [
  {
   "name": "finish them",
   "when": {
    "enemy.topped": true
   },
   "aim": {
    "combo": ">=4"
   },
   "else": {
    "chain": ">=2"
   }
  },
  {
   "name": "dig with a punch",
   "when": {
    "us.heavy": true
   },
   "aim": {
    "break": true,
    "any": [
     {
      "combo": ">=4"
     },
     {
      "chain": ">=2"
     }
    ]
   },
   "by": "us.nextLands",
   "else": "default"
  },
  {
   "name": "break back",
   "when": {
    "us.contact": ">=1"
   },
   "aim": {
    "break": true,
    "any": [
     {
      "combo": ">=4"
     },
     {
      "chain": ">=2"
     }
    ]
   },
   "else": "default"
  },
  {
   "name": "pressure",
   "when": {
    "enemy.height": ">=9"
   },
   "aim": {
    "chain": ">=2"
   },
   "else": {
    "combo": ">=4"
   }
  },
  {
   "name": "build",
   "when": {
    "us.material": ">=24"
   },
   "aim": {
    "chain": ">=3"
   },
   "else": {
    "combo": ">=5"
   }
  },
  {
   "name": "anything big",
   "when": {},
   "aim": {
    "any": [
     {
      "combo": ">=4"
     },
     {
      "chain": ">=2"
     }
    ]
   },
   "else": "default"
  }
 ],
 "opponents": {}
}
